# Turso Database
# Create at: https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# GitHub Personal Access Token
# Required scope: repo (for private repo traffic access)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Cron secret (Vercel deployment only)
# Protects the /api/collect endpoint; Vercel Cron sends it as a Bearer token.
# Generate any random string, e.g. `openssl rand -hex 32`.
# Not needed for local development.
CRON_SECRET=your-random-secret
