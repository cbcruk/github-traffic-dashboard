# Used by `pnpm dev` and `pnpm db:collect`. The deployed Worker reads the same
# values from Cloudflare secrets instead (see README > Deployment).

# GitHub Personal Access Token
# Required scope: repo (for private repo traffic access)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Private repos are collected but hidden from the dashboard by default.
# Set to true only if the dashboard is behind access control (e.g. Cloudflare Access).
# SHOW_PRIVATE_REPOS=true
