# Used by `pnpm dev` and `pnpm db:collect`. The deployed Worker reads the same
# values from Cloudflare secrets instead (see README > Deployment).

# GitHub Personal Access Token
# Classic: repo scope. Fine-grained: Administration read (one owner only, see README > GitHub 토큰)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Which repositories to collect (see README > 수집 대상). Defaults: own repos, no forks.
# GITHUB_ORGS=org1,org2
# EXCLUDE_REPOS=me/dotfiles,me/*-archive
# INCLUDE_FORKS=true
# EXCLUDE_ARCHIVED=true

# Show made-up data instead of collecting from GitHub (see README > 데모 모드).
# DEMO_MODE=true

# Private repos are collected but hidden from the dashboard by default.
# Set to true only if the dashboard is behind access control (e.g. Cloudflare Access).
# SHOW_PRIVATE_REPOS=true

# Deployed Worker only: where the daily health check reports failed collections.
# A repository to track problems in as a GitHub issue (GITHUB_TOKEN needs Issues write).
# ALERT_GITHUB_REPO=owner/github-traffic-dashboard
#
# Discord and Slack webhook URLs are detected; any other URL (e.g. https://ntfy.sh/<topic>)
# receives the alert as a plain-text POST.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
